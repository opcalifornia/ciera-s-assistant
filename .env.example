# Copy this file to .env and fill in what you have. Every variable the app
# reads is declared in api/app/core/config.py and documented here (Section
# 0 rule 4: "never commit secrets. Use .env.example with every variable
# documented.")
#
# Nothing below is required to run `make dev` / `make test` / `make eval`
# locally — every external provider has a free, offline stub that's used
# automatically when its key is blank. Fill these in only once you're
# ready to spend money on a given vendor.

ENV=development
DEBUG=true

# --- Data layer (local docker-compose defaults, no cost) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=greenroom
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-secret-change-me-32-bytes-min!!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- LLM / embeddings / search providers (Section 6) ---
# Blank = StubLLMProvider is used (free, offline, no network calls).
ANTHROPIC_API_KEY=
# Blank = embedding calls are skipped until Phase 1 wires the Brand Brain
# vector index.
VOYAGE_API_KEY=
# Blank = Prospector's SearchProvider calls are skipped until Phase 4.
TAVILY_API_KEY=

# --- LLM tracing (Section 6: self-hosted Langfuse) ---
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Outbound SMS (PLAN.md Section 7 addendum — Phase 1, not yet wired) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_NUMBER=

# --- CORS ---
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
